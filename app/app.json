{
  "expo": {
    "name": "MyQuattro",
    "slug": "myquattro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/myquattro-app-icon-sky-blue-3.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dpipower.myquattro",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSBluetoothAlwaysUsageDescription": "This app uses Bluetooth to connect to Hydro BioScience devices.",
        "NSBluetoothPeripheralUsageDescription": "Bluetooth is required to communicate with your device.",
        "NSLocationWhenInUseUsageDescription": "Location is required for Bluetooth device scanning."
      }
    },
    "android": {
      "package": "com.dpipower.myquattro",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/myquattro-app-icon-sky-blue.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_ADVERTISE",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/hbs-splash.png",
          "imageWidth": 300,
          "resizeMode": "cover",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/hbs-logo-white.png",
            "backgroundColor": "#121212"
          }
        }
      ],
      "react-native-ble-manager",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "82bb2cac-a8a8-4656-8555-c8383a94c02d"
      }
    },
    "owner": "devdpis-organization"
  }
}
